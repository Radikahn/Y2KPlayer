{
  "manifest_version": 3,
  "name": "Y2kTube",
  "version": "1",

  "description": "Adds a mini y2k style mini player for youtube content",

  "action": {
    "default_popup": "index.html"
  },

  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["player.js", "y2ktube.js"]
    }
  ]
}
